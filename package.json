{
  "name": "@sunnylost/prooflane",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first verification harness for coding agents",
  "type": "module",
  "bin": {
    "prooflane": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/mcp.md",
    "skills"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "test": "npm run build && node --test --test-timeout=30000 tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:package": "node --test --test-timeout=120000 tests/package.e2e.mjs",
    "test:compatibility": "node scripts/check-compatibility.mjs",
    "verify:mcp-agent": "node scripts/verify-mcp-agent.mjs",
    "verify:project": "npm run build && node scripts/verify-project.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "knip": "6.41.0",
    "oxlint": "1.87.0",
    "react-doctor": "0.9.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  }
}
